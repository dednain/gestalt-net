# Create DNS A record for this domain pointing to your VPS (with access from Russia).
VOICE_DOMAIN=voice.example.ru
# Public IPv4 of the VPS. Coturn needs it for advertised relay candidates.
PUBLIC_IP=203.0.113.10
# Generate with: openssl rand -hex 32 ; must stay private.
TURN_SECRET=replace-with-random-64-hex-characters
